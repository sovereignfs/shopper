{
  "manifest": 5,
  "prefix": "shopper",
  "name": "Shopper",
  "description": "Your household's shopping lists, working in the shop with no signal, and remembering what you buy",
  "icon": "/icons/icon.svg",
  "port": 3007,
  "health": "/api/health",
  "launch": "/",
  "signIn": {
    "redirect": ["/api/auth/callback/sovereign"],
    "postLogout": ["/sign-in"],
    "backChannel": "/api/sovereign/backchannel-logout",
    "accountDeleted": "/api/sovereign/account-deleted",
    "export": "/api/sovereign/export",
    "scopes": ["openid", "profile", "email", "offline_access"]
  },
  "encryption": {
    "return": "/keys/return"
  },
  "database": true,
  "generate": [
    "SHOPPER_AUTH_SECRET",
    {
      "name": "SHOPPER_ENCRYPTION_KEY",
      "bytes": 32
    },
    {
      "name": "SHOPPER_VAPID_PRIVATE_KEY",
      "bytes": 32
    }
  ],
  "core": ">=0.126.0 <1.0.0"
}
