# Every setting Shopper reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Shopper gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Emailed links, cookies and the Sovereign redirect address are made from it.
SHOPPER_URL=http://localhost:3007

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Key rotation and clean-up run inside the web process. When several processes share one database, set `off` on all but one.
# SHOPPER_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password.
SHOPPER_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
SHOPPER_AUTH_SECRET=
# `open` (the default): anyone who can reach the page may make an account, which is what lets someone with none accept an invitation link.
# `closed`: the first account only; an invitation can then be accepted only by signing in. Set `closed` once everyone who is to share has joined.
# SHOPPER_AUTH_SIGNUP=open
# The shortest password, 8 to 128. Default 10.
# SHOPPER_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). SHOPPER_CORE_URL is the instance's core, its
# OIDC issuer: its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <SHOPPER_URL>/api/auth/callback/sovereign. Needs SHOPPER_URL and SHOPPER_AUTH_SECRET as local sign-in does; SHOPPER_AUTH_LOCAL may then be 0.
# SHOPPER_CORE_URL=https://sovereign.example.com
# SHOPPER_CORE_CLIENT_ID=
# SHOPPER_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# SHOPPER_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# SHOPPER_SQLD_URL=http://sqld:8080
# SHOPPER_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# SHOPPER_SQLITE_URL=file:/data/shopper.db
# postgres: the address, and the most connections the app may hold (2 or more).
# SHOPPER_POSTGRES_URL=postgres://user:password@localhost:5432/shopper
# SHOPPER_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# SHOPPER_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# SHOPPER_MIGRATIONS_DIR=

# --- Encryption at rest ----------------------------------------------------------------------------------------------------------------
# Required. What a household buys (names, notes) is sealed under this key; nothing is stored in plain text. Make it once and keep it with your
# secrets, apart from the database backups: a lost key means the sealed data cannot be read.   openssl rand -base64 32
SHOPPER_ENCRYPTION_KEY=
# While moving to a new key: put the new one above and the old one here until the rotation is done, then remove it.
# SHOPPER_ENCRYPTION_KEY_PREVIOUS=

# --- Mail (optional) -------------------------------------------------------------------------------------------------------------------
# What sign-in sends: address verification and password reset. No host, no mail. Port 587 by default; 465 is SMTPS.
# SHOPPER_SMTP_HOST=smtp.example.com
# SHOPPER_SMTP_PORT=587
# SHOPPER_SMTP_FROM=Shopper <shopper@example.com>
# SHOPPER_SMTP_USER=
# SHOPPER_SMTP_PASSWORD=

# --- Freshness -------------------------------------------------------------------------------------------------------------------------
# How often, in seconds, a visible device asks for what others changed, from 5 to 600. A write, opening the app and coming back online
# sync at once, and shopping mode asks every 10 seconds. Default 20.
# SHOPPER_SYNC_INTERVAL_SECONDS=20

# --- Limits (each a whole number from 1 to 1000000) ------------------------------------------------------------------------------------
# Members of a household. Default 20.
# SHOPPER_LIMIT_HOUSEHOLD_MEMBERS=20
# Households an account is in, its own included. Default 20.
# SHOPPER_LIMIT_ACCOUNT_HOUSEHOLDS=20
# Lists of a household, archived included. Default 100.
# SHOPPER_LIMIT_HOUSEHOLD_LISTS=100
# Open items on a list. Default 500.
# SHOPPER_LIMIT_LIST_OPEN_ITEMS=500
# Products in a household's catalog. Default 5000.
# SHOPPER_LIMIT_HOUSEHOLD_PRODUCTS=5000
