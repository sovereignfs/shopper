# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Shopper reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Emailed links, cookies and the Sovereign redirect address are made from it.
SHOPPER_URL=http://localhost:3007
# The port on this machine that a reverse proxy sends to (the container listens on 3007, the port in sovereign.manifest.json).
# SHOPPER_PORT=3007

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
SHOPPER_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
SHOPPER_AUTH_SECRET=
# `open` (the default): anyone who can reach the page may make an account, which is what lets someone with none accept an invitation link.
# `closed`: the first account only; an invitation can then be accepted only by signing in. A sign-in through a Sovereign core is never refused by it.
SHOPPER_AUTH_SIGNUP=open

# --- Encryption at rest --------------------------------------------------------------------------------------------
# Required. What a household buys (names, notes) is sealed under this key. Make it once and keep it with your secrets, apart from the
# database backups: a lost key means the sealed data cannot be read.   openssl rand -base64 32
SHOPPER_ENCRYPTION_KEY=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
