# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Shopper reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Emailed links, cookies and the Sovereign redirect address are made from it.
SHOPPER_URL=http://localhost:3007
# The port on this machine that a reverse proxy sends to (the container listens on 3007, the port in sovereign.manifest.json).
# SHOPPER_PORT=3007

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
SHOPPER_AUTH_LOCAL=true
# 32 characters or more:  openssl rand -base64 48
SHOPPER_AUTH_SECRET=
# `open` (the default): anyone who can reach the page may make an account, which is what lets someone with none accept an invitation link.
# `closed`: the first account only; an invitation can then be accepted only by signing in. A sign-in through a Sovereign core is never refused by it.
SHOPPER_AUTH_SIGNUP=open

# --- Encryption at rest --------------------------------------------------------------------------------------------
# Required. What people write is encrypted on their devices (docs/encryption.md); this key seals what the server holds itself: people's names and
# addresses, and lists not yet encrypted. Make it once and keep it with your secrets, apart from the database backups: a lost key means what it
# seals cannot be read.   openssl rand -base64 32
SHOPPER_ENCRYPTION_KEY=

# --- Mail (optional) -----------------------------------------------------------------------------------------------
# What sign-in with Shopper's own accounts sends: address verification and password reset. No host, no mail. Port 587 by default; 465 is SMTPS.
# SHOPPER_SMTP_HOST=smtp.example.com
# SHOPPER_SMTP_PORT=587
# SHOPPER_SMTP_FROM=Shopper <shopper@example.com>
# SHOPPER_SMTP_USER=
# SHOPPER_SMTP_PASSWORD=

# --- Web Push (optional) -------------------------------------------------------------------------------------------
# Notifications on a device where Shopper is not open. No key, no push, and Settings offers none. 32 bytes, URL-safe base64. Changing it ends
# every device's subscription.   npx @sovereignfs/push keys
# SHOPPER_VAPID_PRIVATE_KEY=
# Whom the push services can tell when something is wrong: mailto: or https:. Defaults to SHOPPER_URL when that is https.
# SHOPPER_VAPID_SUBJECT=mailto:you@example.com

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
